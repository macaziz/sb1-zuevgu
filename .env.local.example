# Configuration MongoDB
MONGODB_URI=mongodb://username:password@localhost:27017/animeflow

# Ou pour MongoDB sans authentification :
# MONGODB_URI=mongodb://localhost:27017/animeflow

# Ou pour MongoDB Atlas :
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/animeflow

# Clé TMDB (optionnelle, pour l'instant non utilisée)
NEXT_PUBLIC_TMDB_API_KEY=your_tmdb_api_key_here